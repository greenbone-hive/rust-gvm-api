{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenbone.github.io/rust-gvm-api/e2e/comparison.schema.json",
  "title": "rust-gvm-api OSP and direct-OpenVASD contract comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baselineLane", "candidateLane", "contracts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "baselineLane": {"type": "string", "minLength": 1},
    "candidateLane": {"type": "string", "minLength": 1},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract", "baseline", "candidate", "disposition", "ownerRole"],
        "properties": {
          "contract": {"type": "string", "minLength": 1},
          "baseline": {"enum": ["pass", "fail", "not-run"]},
          "candidate": {"enum": ["pass", "fail", "not-run"]},
          "disposition": {"enum": ["equivalent", "backend-specific", "gap", "approved-exclusion"]},
          "ownerRole": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
