{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenbone.github.io/rust-gvm-api/e2e/enterprise-agent-control-evidence.schema.json",
  "title": "Advisory enterprise Agent Control emulator result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "lane", "advisory", "status", "failureClassification", "promotionEligible", "universalCommunityGateChanged", "completedAt", "preflight", "contracts", "failureScenarios", "repeatability", "provenanceSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "lane": {"const": "enterprise-agent-control-emulator-advisory"},
    "advisory": {"const": true},
    "status": {"enum": ["passed", "failed"]},
    "failureClassification": {"type": ["string", "null"], "enum": [null, "setup", "preflight-configuration", "enterprise-contract"]},
    "promotionEligible": {"const": false},
    "universalCommunityGateChanged": {"const": false},
    "completedAt": {"type": "string", "format": "date-time"},
    "preflight": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "classification", "rawResponsesRetained"],
      "properties": {"outcome": {"enum": ["passed", "failed", "not-run"]}, "classification": {"type": ["string", "null"]}, "rawResponsesRetained": {"type": "boolean"}}
    },
    "contracts": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "failureScenarios": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scenario", "injectedAt", "allowedMappings", "observedStatus", "classification", "outcome", "repetition"],
        "properties": {
          "scenario": {"enum": ["authentication", "unavailable", "malformed", "conflict", "rate-limit", "timeout"]},
          "injectedAt": {"const": "upstream-agent-control-profile-selected-via-proxy"},
          "allowedMappings": {
            "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["status", "classification"],
              "properties": {
                "status": {"enum": [401, 502, 504]},
                "classification": {"enum": ["unauthorized", "backend_unavailable", "gateway_timeout"]}
              }
            }
          },
          "observedStatus": {"enum": [401, 502, 504]},
          "classification": {"enum": ["unauthorized", "backend_unavailable", "gateway_timeout"]},
          "outcome": {"const": "pass"},
          "repetition": {"type": "integer", "minimum": 1, "maximum": 2}
        }
      }
    },
    "repeatability": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["number", "outcome", "sha256"],
        "properties": {"number": {"type": "integer", "minimum": 1, "maximum": 2}, "outcome": {"enum": ["pass", "fail", "not-run"]}, "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "provenanceSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
