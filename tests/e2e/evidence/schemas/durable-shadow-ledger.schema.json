{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://greenbone.github.io/rust-gvm-api/e2e/durable-shadow-ledger.schema.json",
  "title": "Append-only durable direct-OpenVASD evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "workflow", "job", "entries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "repository": {"const": "greenbone-hive/rust-gvm-api"},
    "workflow": {"const": ".github/workflows/nightly-e2e.yml"},
    "job": {"const": "Direct OpenVASD Shadow E2E (advisory)"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "runId", "runAttempt", "createdAt", "comparisonFingerprint", "evidenceArtifactId", "rawArtifactId", "provenanceSha256", "payloadSha256", "previousEntrySha256", "files", "entrySha256"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "runId": {"type": "integer", "minimum": 1},
          "runAttempt": {"type": "integer", "minimum": 1},
          "createdAt": {"type": "string", "format": "date-time"},
          "comparisonFingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "evidenceArtifactId": {"type": "integer", "minimum": 1},
          "rawArtifactId": {"type": "integer", "minimum": 1},
          "provenanceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "payloadSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "previousEntrySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "size", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "size": {"type": "integer", "minimum": 0},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "entrySha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
